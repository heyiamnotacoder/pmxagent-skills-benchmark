# third-party / reference material (read-only, not ours to redistribute)
psp470325-sup-0001-appendixs1/
pmxagent-main/
*.pdf
# task references stay local-only (derived from PKanalix reference)
tasks/*/reference/
# bulky run artefacts; per-run summaries are committed under results/
results/raw/
logs/*.log
logs/.resume_lanes.lock/
.DS_Store
.Rhistory
__pycache__/
*.zip
# local only
.claude/
letter/
# paper: figure PDFs are committed (generated by scoring/figures.py); the built manuscript and LaTeX aux files are not
!paper/figures/*.pdf
paper/main.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
